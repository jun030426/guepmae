VITE_GOOGLE_MAPS_API_KEY=
VITE_NAVER_MAP_CLIENT_ID=
# 카카오맵 JavaScript 키 — 지도(키가 있으면 기본 지도), 매물 등록 시 주소→좌표, 360 투어가 없는 매물의 로드뷰.
# 없으면 지도는 OpenStreetMap, 로드뷰 자리는 사진 폴백. 카카오 키가 있어도 OSM 을 쓰려면 VITE_MAP_PROVIDER=osm
VITE_KAKAO_APP_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
